# ─────────────────────────────────────────────────────────────
# PoolDrive Backend — .env.example
# Copy this to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────
# Format: mongodb+srv://<user>:<pass>@<cluster>.mongodb.net
# OR local: mongodb://localhost:27017
MONGO_URI=mongodb://localhost:27017

# ── Redis ─────────────────────────────────────────────────────
# Format: redis://:<password>@<host>:<port>
# Local Docker: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# ── Auth / JWT ────────────────────────────────────────────────
# Use long random strings — e.g. openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_for_access_tokens
ACCESS_TOKEN_EXPIRY=1d

REFRESH_TOKEN_SECRET=replace_with_a_different_long_random_secret_for_refresh
REFRESH_TOKEN_EXPIRY=10d

# ── Storage Encryption ────────────────────────────────────────
# MUST be exactly 32 characters (AES-256-CBC key for bucket credentials)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Bucket Selection Strategy ─────────────────────────────────
# Options: "bestFit" | "leastUsed"
BUCKET_STRATEGY=bestFit

# ── File Upload Limits ────────────────────────────────────────
MAX_FILE_SIZE_BYTES=104857600        # 100 MB
CHUNK_SIZE_BYTES=5242880             # 5 MB per chunk
PRESIGNED_URL_EXPIRY_SECONDS=900     # 15 minutes

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000           # 1 minute window
RATE_LIMIT_MAX_REQUESTS=100          # Max 100 requests per window

# ── Rebalance ─────────────────────────────────────────────────
# Emit rebalance event when a bucket reaches this usage fraction (0.0–1.0)
REBALANCE_THRESHOLD=0.85

# ── CORS ──────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Email (optional — for account verification features) ──────
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password